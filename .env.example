RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
RAG_CONTEXT_MAX_CHARS=8000
RAG_MAX_UPLOAD_MB=15
