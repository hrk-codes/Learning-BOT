GROQ_API_KEY=your-groq-api-key-here
# 20B handles fast paths and workflow steps; 120B is reserved for final synthesis.
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FINAL_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
GROQ_SIMPLE_MAX_TOKENS=384
GROQ_FAST_MAX_TOKENS=512
GROQ_TIMEOUT_SECONDS=60
GROQ_RATE_LIMIT_MAX_RETRIES=2
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=60
RECENT_MESSAGE_LIMIT=10
CHAT_HISTORY_PATH=memory/history.json
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_DB_PATH=memory/long_term_memory.db
LONG_TERM_MEMORY_USER_ID=local-user
LONG_TERM_MEMORY_PROJECT_ID=learning-bot
LONG_TERM_MEMORY_RETRIEVAL_LIMIT=8
LONG_TERM_MEMORY_CONTEXT_MAX_CHARS=4000
MAX_AGENT_ITERATIONS=4
PLANNER_ENABLED=true
PLANNER_TEMPERATURE=0.1
PLANNER_MIN_OUTPUT_TOKENS=640
PLANNER_MAX_TASKS=5
PLANNER_MAX_REVISIONS=2
PLANNER_MAX_EXECUTION_STEPS=12
PLANNER_MAX_TASK_RETRIES=1
PLANNER_MAX_REPAIR_ATTEMPTS=1
LANGGRAPH_ENABLED=true
LANGGRAPH_CHECKPOINT_DB_PATH=graph/checkpoints.db
MULTI_AGENT_ENABLED=true
MULTI_AGENT_CHECKPOINT_DB_PATH=multi_agent/checkpoints.db
MULTI_AGENT_MAX_DELEGATIONS=8
MULTI_AGENT_MAX_AGENT_RETRIES=1
MULTI_AGENT_MAX_REVIEW_REVISIONS=1
MULTI_AGENT_TIMEOUT_SECONDS=60
MULTI_AGENT_OUTPUT_REPAIR_ATTEMPTS=1
APPROVAL_DB_PATH=approval/approvals.db
APPROVAL_TIMEOUT_SECONDS=300
SIDE_EFFECT_PERMISSION_ENABLED=true
RAG_DOCUMENTS_PATH=documents/raw
RAG_VECTOR_STORE_PATH=vector_store/index.json
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
RAG_CONTEXT_MAX_CHARS=8000
RAG_MAX_UPLOAD_MB=15

# Stage 11 platform runtime. SQLite and the embedded worker keep local learning
# setup free; Docker Compose replaces these with PostgreSQL and a separate worker.
PLATFORM_ENV=development
DATABASE_URL=sqlite:///platform_data/platform.db
PLATFORM_JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=0.5
REQUEST_RATE_LIMIT_PER_MINUTE=120
RUN_RATE_LIMIT_PER_MINUTE=10
MAX_RUN_SECONDS=300
MAX_RUN_LLM_CALLS=16
MAX_RUN_TOKENS=16000
OBJECT_STORE_PATH=platform_data/objects
PLATFORM_MEMORY_PATH=platform_data/memory.db
PLATFORM_VECTOR_ROOT=platform_data/vectors
PLATFORM_LOG_LEVEL=INFO
